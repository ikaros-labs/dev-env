# terraform.tfvars is no longer used.
#
# All Terraform variables are set via TF_VAR_* environment variables,
# sourced from the root .env file and passed through docker-compose.yml.
#
# See .env.example in the repository root for configuration.
#
# To override optional variables (region, droplet_size), add
# TF_VAR_region=ams3 etc. directly to .env.
