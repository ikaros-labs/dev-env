#cloud-config
# ---------------------------------------------------------------------------
# Identity & access bootstrap -- one-shot, runs on first boot only.
# This file is rendered by Terraform's templatefile() and injected as
# user_data.  It is marked sensitive in main.tf so it does not appear in
# plan/apply output.
#
# Scope: user creation, sudo, sshd hardening, Tailscale join,
#        root password lock.
# Everything else belongs in Ansible.
# ---------------------------------------------------------------------------

# ---- User ------------------------------------------------------------------
users:
  - name: ${username}
    groups: [sudo]
    shell: /bin/bash
    # lock_passwd: false allows the hashed password to be used for sudo.
    # SSH access is via Tailscale SSH (tailscale up --ssh); no authorized_keys needed.
    lock_passwd: false
    # user_hashed_password is a bcrypt hash derived by Terraform's bcrypt().
    # The $ chars in the hash are safe -- Terraform only interpolates $${...}
    # sequences, not bare $ signs.
    passwd: '${user_hashed_password}'

# ---- SSH hardening ---------------------------------------------------------
write_files:
  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    owner: root:root
    permissions: '0644'
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no

# ---- Bootstrap commands ----------------------------------------------------
# Commands run as root in order; each line is a separate shell invocation.
runcmd:
  # Remove the injected placeholder SSH key -- private key was discarded at
  # provisioning time; clean up the server side too.
  - rm -rf /root/.ssh

  # Lock root password -- root login is also blocked by sshd, but belt + braces.
  - passwd -l root

  # Install Tailscale via official install script (auto-detects distro/version,
  # sets DEBIAN_FRONTEND=noninteractive internally).
  - curl -fsSL https://tailscale.com/install.sh | sh

  # Join the tailnet.
  # --ssh              enables Tailscale SSH (no inbound port needed).
  # --advertise-tags   tag:dev-env enforces ACL policy and is used by
  #                    gen-inventory.sh to assign the correct Ansible group.
  # --auth-key         pre-authorized key.
  - tailscale up --ssh --advertise-tags=tag:dev-env --auth-key='${tailscale_auth_key}'

  # Restart SSH daemon to pick up the hardening drop-in.
  - systemctl restart ssh
