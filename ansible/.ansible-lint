---
# ansible-lint configuration
# https://ansible.readthedocs.io/projects/lint/configuring/

profile: production

# Skip rules that conflict with project conventions.
skip_list:
  # We intentionally use host_key_checking=False in ansible.cfg because
  # all connections go through Tailscale (see ansible.cfg for rationale).
  - "no-host-key-checking"

# Exclude generated and example files.
exclude_paths:
  - hosts.ini  # auto-generated by gen-inventory.sh

warn_list:
  - experimental

# Require FQCN (ansible.builtin.apt, not just apt).
use_default_rules: true
