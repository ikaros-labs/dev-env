// /etc/apt/apt.conf.d/50unattended-upgrades
// Managed by Ansible — do not edit by hand.

Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}";
    "${distro_id}:${distro_codename}-security";
    "${distro_id}ESMApps:${distro_codename}-apps-security";
    "${distro_id}ESM:${distro_codename}-infra-security";
};

// Automatically fix interrupted dpkg runs.
Unattended-Upgrade::AutoFixInterruptedDpkg "true";

// Split the upgrade into the smallest possible chunks to minimize the
// window during which dpkg is locked.
Unattended-Upgrade::MinimalSteps "true";

// Do NOT install on shutdown — we want predictable maintenance windows.
Unattended-Upgrade::InstallOnShutdown "false";

// Clean up after upgrades.
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";

// Reboot automatically after a kernel upgrade.
// WithUsers "false" means reboot even if users are logged in — this is
// intentional for servers; the maintenance window (03:00) is when user
// sessions are not expected.
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-WithUsers "false";

// Maintenance window: 03:00 UTC.  Server will reboot if needed between
// 03:00 and 04:00 (next apt run).
Unattended-Upgrade::Automatic-Reboot-Time "03:00";
