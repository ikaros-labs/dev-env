# Copy this file to .env and fill in your value.
#
# Create an ephemeral, reusable, pre-authorized auth key tagged tag:ops at:
#   https://login.tailscale.com/admin/settings/keys
#
# Then update your Tailscale ACL to allow tag:ops to SSH into tag:dev-env:
#   https://login.tailscale.com/admin/acls
#
# Example ACL SSH rule:
#   {"action": "accept", "src": ["tag:ops"], "dst": ["tag:dev-env"], "users": ["<your-username>"]}
TAILSCALE_AUTH_KEY=tskey-auth-...
