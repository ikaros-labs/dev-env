# =============================================================================
# .env — single source of truth for all secrets and configuration.
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# This file is gitignored.  Never commit it.
# =============================================================================

# =============================================================================
# Provider selection
# =============================================================================

# Which cloud provider to use: hetzner | digitalocean
PROVIDER=hetzner

# =============================================================================
# User identity
# =============================================================================

# Linux username created on all servers.  Also used as ansible_user.
USERNAME=ikaros

# Git identity on remote hosts.
GIT_USER_NAME=
GIT_USER_EMAIL=

# Sudo password for the server user.
# Ansible uses it for privilege escalation (ansible_become_pass).
# Terraform derives a bcrypt hash from it for cloud-init (no manual hashing needed).
USER_PASSWORD=

# =============================================================================
# Tailscale
# =============================================================================

# Auth key for the Docker Compose Tailscale sidecar (tag:ops).
# This key lets the local tools container join the tailnet to reach servers.
# Generate at: https://login.tailscale.com/admin/settings/keys
#   Reusable: on | Ephemeral: on | Pre-authorized: on | Tags: tag:ops
TAILSCALE_OPS_AUTH_KEY=tskey-auth-...

# Tailnet domain (the part after the hostname in MagicDNS).
# Find yours at: https://login.tailscale.com/admin/dns
TAILSCALE_TAILNET=oryx-capella.ts.net

# Auth key for servers provisioned by Terraform (tag:dev-env).
# This key is embedded in cloud-init; servers use it to join the tailnet.
# Generate at: https://login.tailscale.com/admin/settings/keys
#   Reusable: on | Ephemeral: off | Pre-authorized: on | Tags: tag:dev-env
TAILSCALE_SERVER_AUTH_KEY=tskey-auth-...

# =============================================================================
# Cloud provider tokens (fill in the one matching PROVIDER above)
# =============================================================================

# Hetzner Cloud API token (required when PROVIDER=hetzner).
# Create at: https://console.hetzner.cloud/ -> project -> Security -> API Tokens
HCLOUD_TOKEN=

# DigitalOcean API token (required when PROVIDER=digitalocean).
# Create at: https://cloud.digitalocean.com/account/api/tokens
DO_TOKEN=

# =============================================================================
# Ansible secrets
# =============================================================================

# Base domain for services (subdomains like demo.X, agents-new.X are derived).
DOMAIN=nikmel.dev

# Anthropic API key for the agents-orchestrator service on remote hosts.
ANTHROPIC_API_KEY=

# Cloudflare API token for Caddy DNS-01 ACME challenges (optional).
# When set, Caddy obtains wildcard TLS certificates via DNS-01 challenge.
# When empty, Caddy serves plain HTTP only (auto_https off).
CADDY_CF_API_TOKEN=

# GitHub OAuth token for gh CLI authentication on remote hosts (optional).
GH_OAUTH_TOKEN=

# Claude Code OAuth token for Claude Code on remote hosts (optional).
CLAUDE_OAUTH_TOKEN=

# =============================================================================
# Provider-specific config (optional — sensible defaults are used if unset)
# =============================================================================

# Hetzner
# SERVER_LOCATION=fsn1       # fsn1 | nbg1 | hel1 | ash | hil
# SERVER_TYPE=cx22           # see: hcloud server-type list

# DigitalOcean
# REGION=fra1                # fra1 | ams3 | nyc3 | lon1 | sgp1 | sfo3
# DROPLET_SIZE=s-2vcpu-4gb   # see: doctl compute size list
# DO_PROJECT_ID=             # assign droplets to a project; find IDs at https://cloud.digitalocean.com/projects
