// Tailscale policy for the ikaros-iac tailnet.
// HuJSON (JSON with comments) — edit at https://login.tailscale.com/admin/acls
//
// Policy summary:
//   - Servers run under tag:server (ephemeral, pre-authorized keys).
//   - Tailnet members can SSH as ikaros on any tag:server machine.
//   - All traffic between tailnet members is permitted (default Tailscale
//     behaviour); restrict further as the network grows.
{
  // Tag owners — who may assign these tags to a device.
  // autogroup:admin means any admin of this tailnet.
  //
  // tag:server  — applied to every managed server (used for grant/SSH rules).
  // tag:dev     — applied to dev-role servers (used for Ansible group mapping).
  "tagOwners": {
    "tag:server": ["autogroup:admin"],
    "tag:dev":    ["autogroup:admin"]
  },

  // Grants — what traffic is allowed (grants are implicitly allow; no action field).
  "grants": [
    {
      // Allow all tailnet members to reach tag:server devices on any port.
      // Tighten this once specific service ports are known.
      "src": ["autogroup:member"],
      "dst": ["tag:server"],
      "ip":  ["*"]
    }
  ],

  // SSH rules — Tailscale SSH (no OpenSSH port needed).
  "ssh": [
    {
      // Tailnet members may SSH as ikaros to any tag:server device.
      // "accept" allows SSH without requiring interactive Tailscale re-auth,
      // which is necessary for non-interactive clients like Ansible.
      // Switch to "check" if you add a human-facing interactive SSH workflow
      // and want posture-based re-auth enforcement.
      "action": "accept",
      "src":    ["autogroup:member"],
      "dst":    ["tag:server"],
      "users":  ["ikaros"]
    }
  ],

  // Optional: grant admin SSH as root for break-glass scenarios.
  // Uncomment and adjust src to a specific user or group.
  // {
  //   "action": "check",
  //   "src":    ["your-user@example.com"],
  //   "dst":    ["tag:server"],
  //   "users":  ["root"]
  // }
}
